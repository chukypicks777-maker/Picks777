{
  "name": "proyecto-picks-apuesta",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"node server/index.js\" \"vite\"",
    "start": "node server/index.js",
    "share": "concurrently -k -p \"[{name}]\" -n \"SERVER,TUNNEL\" -c \"cyan,green\" \"node server/index.js\" \".\\tools\\cloudflared.exe tunnel --url http://localhost:5000\"",
    "server": "node server/index.js",
    "client": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --import ./tests/setup.js --test tests/*.test.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": "22.x"
  }
}
